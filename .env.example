# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by /setup and `npm run db:setup` to apply
# supabase/schema.sql and seed demo data. (Supabase: Project settings → Database → URI)
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Protects the /setup route. Leave empty to disable /setup entirely.
SETUP_SECRET=
# Password for the seeded demo accounts (Maya Chen, Luca Brunner, …).
DEMO_PASSWORD=accord-demo-2026

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (optional — without it the app runs on seeded AI output) -------------
ANTHROPIC_API_KEY=
# Embeddings for memory retrieval (optional — falls back to full-text search)
VOYAGE_API_KEY=

# --- Live calls (phase 4+) ---------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=

# Signs short-lived breakout / QR join tokens
JOIN_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Background jobs (phase 6) -----------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
